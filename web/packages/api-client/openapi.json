    "/api/audit": {
      "get": {
        "tags": [
          "Audit"
        ],
        "summary": "Audit entries, newest first; pass nextCursor back as cursor for the next page.",
        "operationId": "listAudit",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "take",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 50
            }
          }
        ],
        "responses": {
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagedResultOfAuditEntryDto"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AdminAccountInput": {
        "required": [
          "userName",
          "displayName",
          "password"
        ],
        "type": "object",
        "properties": {
          "userName": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "description": "The first administrator account."
      },
      "AuditEntryDto": {
        "required": [
          "id",
          "occurredAtUtc",
          "actorType",
          "actorId",
          "actorName",
          "action",
          "targetType",
          "targetId",
          "detailsJson",
          "ipAddress"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "occurredAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "actorType": {
            "type": "string",
            "description": "`User`, `System` or `Anonymous`."
          },
          "actorId": {
            "type": [
              "null",
              "string"
            ]
          },
          "actorName": {
            "type": [
              "null",
              "string"
            ]
          },
          "action": {
            "type": "string"
          },
          "targetType": {
            "type": [
              "null",
              "string"
            ]
          },
          "targetId": {
            "type": [
              "null",
              "string"
            ]
          },
          "detailsJson": {
            "type": [
              "null",
              "string"
            ],
            "description": "Optional JSON object with action details."
          },
          "ipAddress": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "description": "One audit log entry, newest first in listings."
      },
      "ChangePasswordRequest": {
        "required": [
          "currentPassword",
          "newPassword"
        ],
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string"
          },
          "newPassword": {
            "type": "string"
          }
        }
      },
      "CompleteSetupRequest": {
        "required": [
          "setupCode",
          "admin",
          "home"
        ],
        "type": "object",
        "properties": {
          "setupCode": {
            "type": "string",
            "description": "The one-time setup code from the server log or `setup-code.txt` (dashes/spaces ignored)."
          },
          "admin": {
            "$ref": "#/components/schemas/AdminAccountInput"
          },
          "home": {
            "$ref": "#/components/schemas/HomeInput"
          }
        },
        "description": "Completes the first-run setup: creates the first Admin and the home, then signs the admin in."
      },
      "CreateUserRequest": {
        "required": [
          "userName",
          "displayName",
          "password",
          "role"
        ],
        "type": "object",
        "properties": {
          "userName": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "description": "`Admin`, `Member` or `Viewer`."
          }
        }
      },
      "HomeDto": {
        "required": [
          "id",
          "name",
          "timeZoneId",
          "latitude",
          "longitude",
          "locale",
          "currency",
          "pricePerKwh",
          "setupCompletedAtUtc",
          "createdAtUtc"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string"
          },
          "timeZoneId": {
            "type": "string",
            "description": "IANA time zone id, e.g. `America/Sao_Paulo`."
          },
          "latitude": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          },
          "longitude": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          },
          "locale": {
            "type": "string",
            "description": "`pt-BR` or `en`."
          },
          "currency": {
            "type": "string",
            "description": "ISO 4217 code, e.g. `BRL`."
          },

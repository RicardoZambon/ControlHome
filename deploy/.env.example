# ControlHome compose settings. Copy to deploy/.env (gitignored) and edit:
#   cp .env.example .env
# Every value below is a placeholder or a default. Never commit a real .env.

# --- Image and process ------------------------------------------------------------------------------------------------

# Image tag of ghcr.io/ricardozambon/controlhome: "edge" (latest main build), a release such as "0.1.0", or "0.1".
CONTROLHOME_VERSION=edge

# Port the app listens on (host networking: on every host interface). Pick one no other app on the host uses.
CONTROLHOME_PORT=8711

# User and group the container runs as (production compose). The ./data folder next to docker-compose.yml must be owned
# by them: mkdir -p data && sudo chown 1000:1000 data
CONTROLHOME_UID=1000
CONTROLHOME_GID=1000

# Time zone of the process (IANA name, e.g. America/Sao_Paulo; default Etc/UTC). The home's own time zone is chosen in
# the setup wizard.
TZ=Etc/UTC

# --- First-run setup --------------------------------------------------------------------------------------------------

# Optional fixed setup code for the first-run wizard. Leave empty to have the app generate one on every start (printed in
# the log and written to data/setup-code.txt until setup is complete).
CONTROLHOME_SETUP_CODE=

# --- Database ---------------------------------------------------------------------------------------------------------

# SQL Server 2025 connection string (env ConnectionStrings__ControlHome). Leave empty to enter the database in the setup
# wizard instead (pre-DB setup mode). Address the server by IP, never by a *.local name. Examples (placeholders):
#   production, bundled-db profile or Umbrel's SQL Server (host networking):
#     Server=127.0.0.1,1433;Database=ControlHome;User Id=ControlHome_App;Password=<password>;TrustServerCertificate=True
#   development compose (docker-compose.dev.yml, bridge network, bundled-db service):
#     Server=mssql,1433;Database=ControlHome_Compose;User Id=sa;Password=<MSSQL_SA_PASSWORD>;TrustServerCertificate=True
CONTROLHOME_DB_CONNECTION=

# SA password of the bundled SQL Server (profile bundled-db). Compose refuses to run without a value, even when the
# bundled-db profile is not used (then any placeholder will do). Use a long random value: SQL Server needs 8+ characters
# from 3 of upper case, lower case, digits and symbols. Avoid ';' (it ends a connection-string value).
MSSQL_SA_PASSWORD=<generate-a-long-random-password>

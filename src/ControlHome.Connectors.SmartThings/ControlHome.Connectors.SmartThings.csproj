<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The SmartThings connector: the household's own OAuth-In app (or a short-lived personal access token for development),
    adaptive polling of the cloud REST API and commands. Like every connector it references Connectors.Abstractions only
    (enforced by the architecture tests); HTTP comes from IHttpClientFactory.
  -->
  <PropertyGroup>
    <RootNamespace>ControlHome.Connectors.SmartThings</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ControlHome.Connectors.Abstractions\ControlHome.Connectors.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ControlHome.Connectors.Tests" />
  </ItemGroup>

  <!-- The setup wizard's instructions for creating the OAuth-In app: data, kept in step with docs/connectors/smartthings.md. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\setup-instructions.json" LogicalName="ControlHome.Connectors.SmartThings.setup-instructions.json" />
  </ItemGroup>

</Project>

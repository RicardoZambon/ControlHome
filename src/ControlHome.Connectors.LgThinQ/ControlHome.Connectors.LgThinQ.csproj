<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The LG ThinQ connector (ThinQ Connect personal access token API): REST + outbound MQTT (AWS IoT, client certificate).
    A C# port of the relevant parts of LG's Apache-2.0 pythinqconnect, cross-checked with jsthinqconnect (see NOTICE).
    Like every connector it references Connectors.Abstractions only (enforced by the architecture tests).
  -->
  <PropertyGroup>
    <RootNamespace>ControlHome.Connectors.LgThinQ</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="MQTTnet" />
    <PackageReference Include="System.Threading.RateLimiting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ControlHome.Connectors.Abstractions\ControlHome.Connectors.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Amazon Root CA 1 (public), the trust anchor of the AWS IoT MQTT endpoint: bundled, never downloaded at runtime. -->
    <!-- .crt (PEM inside): *.pem is gitignored as key material, and this is a public certificate. -->
    <EmbeddedResource Include="Mqtt\AmazonRootCA1.crt" LogicalName="ControlHome.Connectors.LgThinQ.AmazonRootCA1.crt" />
    <None Include="NOTICE" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ControlHome.Connectors.Tests" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Simulated connector (dev, demo, E2E). Like every connector it references Connectors.Abstractions only. -->
  <PropertyGroup>
    <RootNamespace>ControlHome.Connectors.Simulated</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ControlHome.Connectors.Abstractions\ControlHome.Connectors.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ControlHome.Connectors.Tests" />
  </ItemGroup>

  <!-- The demo cameras' snapshots: synthetic scenes drawn by a script (no real footage). -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\*.png" LogicalName="ControlHome.Connectors.Simulated.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>

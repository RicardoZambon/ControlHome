<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ControlHome.Application</RootNamespace>
  </PropertyGroup>

  <!--
    Application may use ASP.NET Core Identity's *model* (IdentityUser, UserManager: namespace Microsoft.AspNetCore.Identity
    from the Microsoft.Extensions.Identity.* packages) but never the web stack: no FrameworkReference to
    Microsoft.AspNetCore.App and no Http/Mvc/Routing/Hosting/Authentication types (enforced by the architecture tests).
  -->
  <ItemGroup>
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.Extensions.Identity.Stores" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ControlHome.Domain\ControlHome.Domain.csproj" />
    <!-- The connector SDK's contracts (descriptors, command batches/outcomes): the command service and integrations use them. -->
    <ProjectReference Include="..\ControlHome.Connectors.Abstractions\ControlHome.Connectors.Abstractions.csproj" />
  </ItemGroup>

</Project>

{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ControlHome": {
    "DataPath": "/data"
  },
  "Database": {
    "StartupTimeout": "00:10:00",
    "AutoMigrate": true
  }
}
